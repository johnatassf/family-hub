{
  "name": "@familia/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:staging": "vite build --mode staging && wrangler deploy",
    "deploy:production": "vite build --mode production && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --config wrangler.jsonc --local",
    "db:migrate:staging": "wrangler d1 migrations apply DB --config wrangler.jsonc --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply DB --config wrangler.jsonc --env production --remote",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "@familia/core": "^0.0.0",
    "@familia/finance": "^0.0.0",
    "@familia/shared": "^0.0.0",
    "@familia/store": "^0.0.0",
    "@familia/ui": "^0.0.0",
    "@tanstack/react-query": "^5.108.2",
    "better-auth": "^1.7.27",
    "hono": "^4.13.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "recharts": "^3.11.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.165.0"
  }
}
